# ─────────────── RouterAI API ───────────────
ROUTERAI_API_KEY=sk-xxxxxxxxxxxxxxxx
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
LLM_MODEL=deepseek/deepseek-v3.2
LLM_FALLBACK_MODEL=qwen/qwen3.5-flash-02-23
EMBEDDING_MODEL=baai/bge-m3
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ─────────────── Database ───────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ticket_tamer

# ─────────────── Email (IMAP) ───────────────
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=support@example.com
IMAP_PASSWORD=changeme

# ─────────────── Email (SMTP) ───────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASSWORD=changeme

# ─────────────── App ────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ─────────────── KB Cleanup / Retention ─────
KB_RETENTION_DAYS=180
KB_CLEANUP_INTERVAL_H=24

# ─────────────── Classification ─────────────
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7

# ─────────────── Telegram ───────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-100123456789

# ─────────────── Google Sheets ──────────────
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=1ABC...xyz

# ─────────────── Secure network ─────────────
JWT_SECRET_KEY=your_key
